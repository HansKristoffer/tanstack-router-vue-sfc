{
  "name": "tanstack-router-sfc",
  "version": "1.0.0",
  "description": "TanStack Router for Vue with single-file routes: define the route in a <router lang=\"ts\"> block inside the .vue file that renders it.",
  "type": "module",
  "main": "./dist/vite.mjs",
  "types": "./dist/vite.d.mts",
  "exports": {
    ".": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./volar": "./volar.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "volar.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "lint": "bun run typecheck && biome check",
    "lint:write": "bun run typecheck && biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky"
  },
  "keywords": [
    "vite-plugin",
    "vue",
    "tanstack-router",
    "sfc",
    "file-based-routing"
  ],
  "author": "Hans Kristoffer",
  "license": "MIT",
  "homepage": "https://github.com/HansKristoffer/tanstack-router-vue-sfc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HansKristoffer/tanstack-router-vue-sfc.git"
  },
  "bugs": {
    "url": "https://github.com/HansKristoffer/tanstack-router-vue-sfc/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "peerDependencies": {
    "@tanstack/router-plugin": ">=1.140.0",
    "@tanstack/vue-router": ">=1.140.0",
    "vite": ">=6.3.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tanstack/router-plugin": "^1.168.23",
    "@tanstack/vue-router": "^1.170.17",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "husky": "^9.1.7",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
